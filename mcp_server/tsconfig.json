{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "NodeNext"
  },
  "include": ["src/**/*"],
  "ts-node": {
    "esm": true,
    "transpileOnly": true, // Speeds up ts-node by skipping type checking
    "swc": true // Uses SWC for faster transpilation if @swc/core is installed
  },
  "exclude": ["node_modules", "**/*.test.ts"]
}
